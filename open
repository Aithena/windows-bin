#!/usr/bin/env bash
# 用法:
#   open             用浏览器打开当前分支
#   open 1.11.11     打开该 tag 页面

set -eu

if [ -t 1 ]; then
  C_CYAN=$'\033[36m'
  C_RESET=$'\033[0m'
else
  C_CYAN="" C_RESET=""
fi

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
用法:
  open             用浏览器打开当前分支
  open 1.11.11     打开该 tag 页面
  open -h          显示帮助
EOF
}

need_git() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "当前目录不是 git 仓库"
}

primary_remote() {
  if git remote | grep -qx origin; then
    echo origin
    return
  fi
  git remote | head -n1
}

https_base() {
  local remote url
  remote=$(primary_remote)
  [ -n "$remote" ] || die "没有 git remote"
  url=$(git remote get-url "$remote")
  url="${url%.git}"
  url="${url%/}"

  if [[ "$url" =~ ^git@([^:]+):(.+)$ ]]; then
    echo "https://${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  elif [[ "$url" =~ ^ssh://([^@]+@)?([^/]+)/(.+)$ ]]; then
    echo "https://${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
  elif [[ "$url" =~ ^https?:// ]]; then
    echo "$url"
  else
    die "无法解析远程地址: $url"
  fi
}

web_page() {
  local base="$1" kind="$2" name="${3:-}"
  local host="${base#https://}"
  host="${host#http://}"
  host="${host%%/*}"

  case "$host" in
    *gitlab*)
      case "$kind" in
        branch) echo "$base/-/tree/$name" ;;
        tag) echo "$base/-/tags/$name" ;;
        *) echo "$base" ;;
      esac
      ;;
    *)
      case "$kind" in
        branch) echo "$base/tree/$name" ;;
        tag) echo "$base/releases/tag/$name" ;;
        *) echo "$base" ;;
      esac
      ;;
  esac
}

browse() {
  local url="$1"
  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe //c start "" "$url" >/dev/null 2>&1
  elif [ -x /usr/bin/open ]; then
    /usr/bin/open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1
  else
    die "无法打开浏览器，请手动访问: $url"
  fi
}

open_url() {
  local url="$1"
  printf '%s%s%s\n' "$C_CYAN" "$url" "$C_RESET"
  browse "$url"
}

do_open_current() {
  local base branch tag
  need_git
  base=$(https_base)

  branch=$(git branch --show-current || true)
  if [ -n "$branch" ]; then
    open_url "$(web_page "$base" branch "$branch")"
    return
  fi

  tag=$(git describe --tags --exact-match 2>/dev/null || true)
  if [ -n "$tag" ]; then
    open_url "$(web_page "$base" tag "$tag")"
    return
  fi

  open_url "$base"
}

do_open_ref() {
  local name="$1" base
  need_git
  base=$(https_base)

  if git rev-parse -q --verify "refs/tags/$name" >/dev/null; then
    open_url "$(web_page "$base" tag "$name")"
  elif git rev-parse -q --verify "refs/heads/$name" >/dev/null; then
    open_url "$(web_page "$base" branch "$name")"
  else
    open_url "$(web_page "$base" tag "$name")"
  fi
}

case "${1:-}" in
  "")
    do_open_current
    ;;
  -h|--help)
    usage
    ;;
  -*)
    die "未知参数: $1
$(usage)"
    ;;
  *)
    if [ "$#" -ne 1 ]; then
      die "一次只接收一个名称
$(usage)"
    fi
    do_open_ref "$1"
    ;;
esac
